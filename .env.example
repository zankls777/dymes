# 数据库配置
DATABASE_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=SubList

# Flask配置
FLASK_APP=app_factory.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# 上传配置
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=104857600

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
